{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "jsx": "react-jsx",
    "paths": {
      "@utils/*": ["src/utils/*"],
      "@features/*": ["src/features/*"],
      "@ui/*": ["src/ui/*"],
      "@real-react": ["node_modules/@types/react/index.d.ts"],
      "@real-react-dom": ["node_modules/@types/react-dom/index.d.ts"],
      "@real-react-dom-client": ["node_modules/@types/react-dom/client.d.ts"]
    },
    "types": ["bun-types", "tampermonkey", "vite/client"]
  },
  "include": ["src/**/*", "scripts/**/*"]
}
